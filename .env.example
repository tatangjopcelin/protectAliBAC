APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Apple Push Notifications (APNs) – notifications push iOS
# Créer une clé .p8 dans Apple Developer > Certificates, Identifiers & Profiles > Keys (Push Notifications activé)
APN_KEY_ID=
APN_TEAM_ID=
APN_BUNDLE_ID=com.tdblg.app
APN_KEY_PATH=storage/app/AuthKey_XXXXX.p8
APN_SANDBOX=true

# Firebase Cloud Messaging (FCM) – notifications push Android
# Le backend lit uniquement FCM_CREDENTIALS_JSON (pas FIREBASE_CREDENTIALS_JSON).
# Chemin (relatif au projet ou absolu) vers le JSON du compte de service Firebase.
# Firebase Console > Project settings > Service accounts > Generate new private key → télécharger le JSON,
# le placer dans storage/app/firebase-credentials.json puis : FCM_CREDENTIALS_JSON=storage/app/firebase-credentials.json
FCM_CREDENTIALS_JSON=

# Twilio SMS (France) – employés (rapports, planning, alertes) + super admin (demandes demo si users.phone renseigne)
# Créer un compte sur https://www.twilio.com/console et acheter un numéro français si besoin
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Web Push PWA (iOS Home Screen / Android / Desktop)
# Générer des clés VAPID (exemple): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@brole.store

# Stripe (abonnement par carte bancaire)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=fr_FR
# IDs des prix Stripe (créer les produits/prix dans le dashboard Stripe)
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_ANNUEL=
